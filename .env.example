# Dudu — réglages du déploiement club (M7).
# Copie ce fichier en .env, adapte : .env n'est jamais versionné.

# Secret de session : génère une longue chaîne aléatoire
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DUDU_SECRET_KEY=change-moi-une-longue-chaine-aleatoire

# Où le service écoute SUR LA MACHINE CLUB (adresse locale du réseau
# du club ; jamais 0.0.0.0 côté box — l'accès distant passe par
# WireGuard, pas par un port rendu public).
DUDU_ECOUTE=192.168.1.10:8000

# Nom et IP sous lesquels l'équipe rejoint Dudu (hôtes autorisés).
DUDU_ALLOWED_HOSTS=dudu.local,192.168.1.10

# Si besoin, origines explicites pour les formulaires (avec schéma).
# DUDU_ORIGINES_CSFR=http://dudu.local,http://192.168.1.10

# Carte : le centre nautique.
DUDU_CENTRE_CARTE=48.42,-4.55
DUDU_ZOOM_CARTE=16

# Sauvegarde quotidienne (cron dans le conteneur) :
# BACKUP_DEST : chemin local (monter le disque de sauvegarde) ou
# distant rsync (user@hote:/chemin). Vide = pas de sauvegarde.
BACKUP_DEST=/mnt/sauvegardes/dudu
DUDU_CRON=30 3 * * *
DUDU_RETENTION_JOURS=90

# Volume des données (base, photos, plans, sauvegardes locales).
DUDU_VOLUME=./data
DUDU_TRAVAILLEURS=3
